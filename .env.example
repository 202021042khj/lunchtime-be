# 복사해서 .env로 쓴다 (cp .env.example .env). .env는 git에 올리지 않는다

NODE_ENV=development
PORT=4000
# 프론트 주소 (쉼표로 여러 개)
CORS_ORIGIN=http://localhost:3000
# 이 API 서버의 바깥 주소 (리뷰 사진 업로드 주소에 쓴다)
API_PUBLIC_URL=http://localhost:4000

# docker-compose.yml과 맞춘 값
DATABASE_URL=postgresql://lunchtime:lunchtime@localhost:5432/lunchtime?schema=public
REDIS_URL=redis://localhost:6379

# 32자 이상. 사용자 · 어드민 토큰은 서로 다른 비밀값으로 서명한다
JWT_SECRET=change-me-user-jwt-secret-at-least-32-chars
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-at-least-32-chars

# 외부 API (2단계-3에서 사용, 그 전에는 비워 둬도 된다)
KAKAO_REST_KEY=
# 카카오 로그인 (콘솔 > 앱 설정 > 앱 키)
KAKAO_APP_ID=
# 콘솔 > 카카오 로그인 > 보안에서 Client Secret을 켰을 때만
KAKAO_CLIENT_SECRET=
# 탈퇴 시 카카오 연결 끊기용 어드민 키 (선택)
KAKAO_ADMIN_KEY=

# 구글 로그인 (Google Cloud 콘솔 > OAuth 클라이언트). 웹 client ID가 첫 번째, 앱용은 쉼표로 이어서
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=

# 애플 로그인 (Apple Developer). 개발자 계정 · https 주소가 생기면 채운다
APPLE_SERVICE_ID=
APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 키 내용, 줄바꿈은 \n으로
APPLE_PRIVATE_KEY=
KMA_SERVICE_KEY=
# 기상청 단기예보 End Point (비우면 https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0)
KMA_BASE_URL=

# 개발 전용 (NODE_ENV=development일 때만 동작, 운영에서는 무시)
# 어드민 OTP 대신 받을 고정값. 비우면 인증 앱 6자리만 받는다
ADMIN_OTP_DEV_CODE=123456
# 소셜 로그인에 providerToken "dev:<아이디>"를 허용 (실제 연동 전 시험용)
SOCIAL_DEV_LOGIN=true

# 이미지 저장소 (S3 호환). 개발은 docker-compose의 RustFS, 운영은 S3 · R2 등 (S3_ENDPOINT를 비우면 AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lunchtime
S3_ACCESS_KEY=lunchtime
S3_SECRET_KEY=lunchtime-storage
# 이미지 공개 주소 앞부분 (운영은 CDN 주소)
S3_PUBLIC_URL=http://localhost:9000/lunchtime
S3_FORCE_PATH_STYLE=true

// lunchtime DB 스키마. 계약은 lunchtime-fe/API.md, 테이블 구성은 lunchtime-fe/plan.md "DB 테이블"을 따른다.
// 식당은 카카오 장소 ID(placeId)로만 가리키고 식당 테이블은 두지 않는다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- 사용자 · 인증 ----------

enum LoginProvider {
  kakao
  apple
  google
  email
}

enum UserStatus {
  active
  suspended
  withdrawn
}

model User {
  id                  String        @id @default(cuid())
  provider            LoginProvider
  // 소셜: 각 회사의 사용자 ID, 이메일 계정: 소문자 이메일
  providerId          String
  email               String?
  passwordHash        String?
  // 소셜 회사가 준 refresh token. 지금은 애플만: 탈퇴할 때 애플 토큰 폐기(revoke)에 쓴다 (앱스토어 규칙)
  socialRefreshToken  String?
  name                String        @db.VarChar(12)
  status              UserStatus    @default(active)
  // 정지 중일 때 끝나는 시각, 무기한이면 null
  suspendedUntil      DateTime?
  suspendReason       String?       @db.VarChar(200)
  onboardingCompleted Boolean       @default(false)
  failedLoginCount    Int           @default(0)
  // 로그인 5번 연속 실패 시 15분 잠금
  lockedUntil         DateTime?
  createdAt           DateTime      @default(now())
  lastActiveAt        DateTime?
  withdrawnAt         DateTime?

  preference         UserPreference?
  locations          SavedLocation[]
  favorites          Favorite[]
  reviews            Review[]
  reports            ReviewReport[]
  menuReports        MenuReport[]
  recommendationLogs RecommendationLog[]
  refreshTokens      RefreshToken[]
  photos             ReviewPhoto[]

  @@unique([provider, providerId])
  @@index([status])
  @@index([createdAt])
}

enum EmailCodePurpose {
  signup
  reset
}

// 이메일 인증번호 (10분 유효, 5번 틀리면 다시 받기, verificationToken은 한 번만)
model EmailVerification {
  id                String           @id @default(cuid())
  email             String
  purpose           EmailCodePurpose
  codeHash          String
  attempts          Int              @default(0)
  expiresAt         DateTime
  verifiedAt        DateTime?
  verificationToken String?          @unique
  usedAt            DateTime?
  createdAt         DateTime         @default(now())

  @@index([email, purpose, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- 취향 · 위치 · 찜 ----------

model UserPreference {
  userId              String   @id
  dislikedIngredients String[]
  allergies           String[]
  // 0 못 먹어요 ~ 4 아주 매운맛, 건너뛰면 null
  spiceLevel          Int?     @db.SmallInt
  favoriteCuisines    String[]
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedLocation {
  id        String   @id @default(cuid())
  userId    String
  label     String
  name      String
  address   String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 표시용 식당 정보(이름 · 좌표 · 카테고리)를 같이 저장한다 (카카오 약관 확인 필요 — API.md 미결정 사항)
model Favorite {
  userId       String
  placeId      String
  placeName    String
  category     String
  categoryPath String
  address      String
  lat          Float
  lng          Float
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
  @@index([placeId])
}

// ---------- 메뉴 마스터 · 재료 사전 ----------

enum MenuWeather {
  clear
  hot
  cold
  rain
  snow
}

model Menu {
  id            String        @id @default(cuid())
  name          String        @unique
  // 종류: 한식 · 중식 … (취향 "좋아하는 음식 종류"와 같은 값)
  cuisine       String
  // 세부: 찌개류 · 면류 … (광고 노출 카테고리)
  category      String
  imageUrl      String?
  ingredients   String[]
  tastes        String[]
  spiceLevel    Int           @db.SmallInt
  // 비어 있으면 "상관없음"
  weathers      MenuWeather[]
  kakaoKeyword  String
  kakaoCategory String
  visible       Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  recommendationLogs RecommendationLog[]
  menuReports        MenuReport[]
  evidence           PlaceMenuEvidence[]

  @@index([cuisine])
}

// 재료 사전. inOptions = 취향 화면 "못 먹는 재료" 기본 선택지
model Ingredient {
  name      String  @id
  inOptions Boolean @default(false)
  sortOrder Int     @default(0)
}

// 알레르기 → 메뉴 재료 대응 (예: "갑각류 (새우·게)" → 새우 · 게 · 꽃게)
model Allergy {
  name        String   @id
  ingredients String[]
  sortOrder   Int      @default(0)
}

// ---------- 리뷰 · 신고 ----------

model Review {
  id        String    @id @default(cuid())
  userId    String
  placeId   String
  placeName String
  rating    Int       @db.SmallInt
  menus     String[]
  tags      String[]
  content   String?   @db.VarChar(500)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // 작성자 삭제 또는 신고 처리로 삭제 (기록은 남긴다)
  deletedAt DateTime?

  user    User           @relation(fields: [userId], references: [id])
  photos  ReviewPhoto[]
  reports ReviewReport[]

  @@index([placeId, createdAt])
  @@index([userId, placeId, createdAt])
}

// 업로드 URL 발급 시 만들고, 리뷰 등록 때 reviewId를 붙인다
model ReviewPhoto {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String?
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([reviewId])
}

// 식당별 집계 (리뷰 등록 · 수정 · 삭제, 찜 시 같은 요청 안에서 갱신)
model PlaceStats {
  placeId       String   @id
  ratingSum     Int      @default(0)
  reviewCount   Int      @default(0)
  favoriteCount Int      @default(0)
  updatedAt     DateTime @updatedAt
}

enum ReportReason {
  abuse
  ad
  false_info
  irrelevant
}

enum ReportStatus {
  pending
  resolved
}

enum ReportResolution {
  dismissed
  deleted
}

model ReviewReport {
  id           String            @id @default(cuid())
  reviewId     String
  reporterId   String
  reason       ReportReason
  memo         String?           @db.VarChar(200)
  status       ReportStatus      @default(pending)
  resolution   ReportResolution?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())

  review     Review     @relation(fields: [reviewId], references: [id])
  reporter   User       @relation(fields: [reporterId], references: [id])
  resolvedBy AdminUser? @relation(fields: [resolvedById], references: [id])

  @@unique([reviewId, reporterId])
  @@index([status, createdAt])
}

// "이 메뉴 안 팔아요" 제보. 같은 사용자 · 식당 · 메뉴는 한 번
model MenuReport {
  id        String   @id @default(cuid())
  userId    String
  placeId   String
  menuId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId, menuId])
  @@index([placeId, menuId])
}

// 식당이 이 메뉴를 판다는 근거 (리뷰 · 제보 시 갱신, 정렬과 근거 문구에 사용)
model PlaceMenuEvidence {
  placeId         String
  menuId          String
  reviewCount     Int      @default(0)
  ownerRegistered Boolean  @default(false)
  reportCount     Int      @default(0)
  updatedAt       DateTime @updatedAt

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([placeId, menuId])
}

// 같은 메뉴 반복 추천 방지, 받은 추천 수, 어드민 7일 추천 수. 비로그인은 userId null
model RecommendationLog {
  id        String   @id @default(cuid())
  userId    String?
  menuId    String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  menu Menu  @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([menuId, createdAt])
}

// ---------- 광고 식당 고정 ----------

enum PaymentStatus {
  pending
  paid
}

// 상태(예약 · 진행 중 · 종료)는 기간과 canceledAt으로 계산한다
model SponsoredPlace {
  id               String        @id @default(cuid())
  placeId          String
  placeName        String
  address          String
  lat              Float
  lng              Float
  category         String
  targetMenuIds    String[]
  targetCategories String[]
  // 500 · 1000 · 2000 · 3000
  radiusM          Int
  startDate        DateTime      @db.Date
  endDate          DateTime      @db.Date
  // { open, close, break: [시작, 끝] | null, closedDays[] }
  hours            Json?
  // 식당 사진 (어드민이 올린 것, 우리 저장소 주소). 사진 없는 식당 목록에서 이 사진을 쓴다
  imageUrl         String?
  priority         Int           @db.SmallInt
  feeKrw           Int
  paymentStatus    PaymentStatus @default(pending)
  canceledAt       DateTime?
  impressions      Int           @default(0)
  clicks           Int           @default(0)
  renewedFromId    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([placeId])
  @@index([startDate, endDate])
}

// ---------- 어드민 ----------

model AdminUser {
  id               String    @id @default(cuid())
  loginId          String    @unique
  passwordHash     String
  // TOTP 비밀값 (base32)
  otpSecret        String
  name             String
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())

  refreshTokens   AdminRefreshToken[]
  auditLogs       AdminAuditLog[]
  resolvedReports ReviewReport[]
}

model AdminRefreshToken {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

// 모든 어드민 변경 + 로그인 성공 · 실패 (누가, 언제, 무엇을)
model AdminAuditLog {
  id         String   @id @default(cuid())
  // 로그인 실패처럼 운영자를 특정할 수 없으면 null
  adminId    String?
  action     String
  targetType String?
  targetId   String?
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId])
}
